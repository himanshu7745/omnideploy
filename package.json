{
  "name": "omnideploy-cli",
  "version": "0.4.0",
  "description": "One CLI to detect, containerize and deploy any project to Vercel, Netlify, GitHub Pages, Railway, Render and more.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu7745/omnideploy.git"
  },
  "homepage": "https://github.com/himanshu7745/omnideploy#readme",
  "bugs": {
    "url": "https://github.com/himanshu7745/omnideploy/issues"
  },
  "type": "module",
  "bin": {
    "omnideploy": "dist/main.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint:arch && npm test",
    "smoke:docker": "npm run build && scripts/docker-smoke.sh",
    "prepublishOnly": "npm run check && npm run build",
    "site:build": "tsc -p website/tsconfig.json",
    "site:dev": "tsc -p website/tsconfig.json && (tsc -p website/tsconfig.json --watch --preserveWatchOutput & npx --yes serve website/public)"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "archiver": "^8.0.0",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.12.0",
    "ignore": "^7.0.14",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "msw": "^3.0.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "deploy",
    "cli",
    "vercel",
    "netlify",
    "github-pages",
    "railway",
    "render",
    "docker"
  ]
}
