exports[`Dockerfile templates > django 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM python:3.11-slim AS deps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN python -m venv /venv
COPY requirements.txt ./
RUN /venv/bin/pip install -r requirements.txt gunicorn

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/venv/bin:$PATH PORT=8000
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=deps /venv /venv
COPY --chown=app:app . .
USER app
RUN python manage.py collectstatic --noinput || echo "omnideploy: build step 'python manage.py collectstatic --noinput' skipped (needs runtime config)"
EXPOSE 8000
CMD ["sh", "-c", "exec gunicorn mysite.wsgi:application --bind 0.0.0.0:$PORT"]
"
`;

exports[`Dockerfile templates > dotnet 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY TodoApi.csproj ./
RUN dotnet restore
COPY . .
RUN dotnet publish -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out .
USER app
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec env ASPNETCORE_URLS=http://+:$PORT dotnet TodoApi.dll"]
"
`;

exports[`Dockerfile templates > express 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec npm start"]
"
`;

exports[`Dockerfile templates > fastapi 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM python:3.12-slim AS deps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN python -m venv /venv
COPY pyproject.toml uv.lock ./
RUN pip install uv && uv export --frozen --no-dev --no-hashes --no-emit-project -o requirements.txt && /venv/bin/pip install -r requirements.txt

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/venv/bin:$PATH PORT=8000
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=deps /venv /venv
COPY --chown=app:app . .
USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:api --host 0.0.0.0 --port $PORT"]
"
`;

exports[`Dockerfile templates > go 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.su[m] ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
ENV PORT=8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app"]
"
`;

exports[`Dockerfile templates > laravel 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.loc[k] ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --ignore-platform-reqs --optimize-autoloader

FROM php:8.2-cli
RUN docker-php-ext-install pdo pdo_mysql opcache && useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=vendor --chown=app:app /app/vendor ./vendor
COPY --chown=app:app . .
USER app
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec php artisan serve --host=0.0.0.0 --port=$PORT"]
"
`;

exports[`Dockerfile templates > next 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:20-alpine
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production PORT=3000
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec pnpm start"]
"
`;

exports[`Dockerfile templates > plain-html 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM busybox:1.36 AS files
WORKDIR /src
COPY . .
RUN cp -r . /out

FROM nginxinc/nginx-unprivileged:1.27-alpine
ENV PORT=8080
USER root
RUN mkdir -p /etc/nginx/templates && printf 'server {\\n  listen \${PORT};\\n  root /usr/share/nginx/html;\\n  location / { try_files $uri $uri/ /index.html; }\\n}\\n' > /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf && chown -R 101:101 /etc/nginx/conf.d /etc/nginx/templates
COPY --from=files --chown=101:101 /out /usr/share/nginx/html
USER 101
EXPOSE 8080
"
`;

exports[`Dockerfile templates > rails 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM ruby:3.3-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git libpq-dev libyaml-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV BUNDLE_WITHOUT="development:test" RAILS_ENV=production RACK_ENV=production
COPY Gemfile Gemfile.loc[k] ./
RUN bundle install --jobs 4
COPY . .
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

FROM ruby:3.3-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 libyaml-0-2 && rm -rf /var/lib/apt/lists/* \\
  && useradd --create-home --uid 10001 app
WORKDIR /app
ENV BUNDLE_WITHOUT="development:test" RAILS_ENV=production RACK_ENV=production RAILS_LOG_TO_STDOUT=1 RAILS_SERVE_STATIC_FILES=1 PORT=3000
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build --chown=app:app /app /app
USER app
EXPOSE 3000
CMD ["sh", "-c", "exec bundle exec rails server -b 0.0.0.0 -p $PORT"]
"
`;

exports[`Dockerfile templates > rust 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM rust:1-slim AS build
WORKDIR /src
COPY . .
RUN cargo build --release --bin edge-proxy && cp target/release/edge-proxy /out-app

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* \\
  && useradd --system --uid 10001 app
COPY --from=build /out-app /usr/local/bin/app
ENV PORT=8080
USER app
EXPOSE 8080
CMD ["app"]
"
`;

exports[`Dockerfile templates > spring-gradle 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM gradle:jdk17 AS build
WORKDIR /src
COPY build.gradle* settings.gradle* gradle.properties* ./
RUN gradle dependencies --no-daemon -q || true
COPY . .
RUN gradle bootJar -x test --no-daemon -q
RUN mkdir /out && cp "$(ls build/libs/*.jar | grep -v -e '-plain.jar$' -e '-sources.jar$' -e '-javadoc.jar$' -e '/original-' | head -n 1)" /out/app.jar

FROM eclipse-temurin:17-jre
RUN useradd --system --create-home --uid 10001 app
WORKDIR /app
COPY --from=build --chown=app:app /out ./
USER app
ENV PORT=8080 JAVA_OPTS="-XX:MaxRAMPercentage=75"
EXPOSE 8080
CMD ["sh", "-c", "exec java $JAVA_OPTS -Dserver.port=$PORT -jar app.jar"]
"
`;

exports[`Dockerfile templates > spring-maven 1`] = `
"# syntax=docker/dockerfile:1
# Generated by omnideploy — safe to edit; omnideploy will not overwrite it without --force.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml ./
RUN mvn -B -q dependency:go-offline || true
COPY . .
RUN mvn -B -q -DskipTests package
RUN mkdir /out && cp "$(ls target/*.jar | grep -v -e '-plain.jar$' -e '-sources.jar$' -e '-javadoc.jar$' -e '/original-' | head -n 1)" /out/app.jar

FROM eclipse-temurin:21-jre
RUN useradd --system --create-home --uid 10001 app
WORKDIR /app
COPY --from=build --chown=app:app /out ./
USER app
ENV PORT=8080 JAVA_OPTS="-XX:MaxRAMPercentage=75"
EXPOSE 8080
CMD ["sh", "-c", "exec java $JAVA_OPTS -Dserver.port=$PORT -jar app.jar"]
"
`;

